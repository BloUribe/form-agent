ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_TO=
# Dominios que el agente puede visitar (JSON). Usa ["*"] para permitir cualquiera.
# ALLOWED_DOMAINS=["www.selenium.dev","localhost","127.0.0.1"]
# DRY_RUN=true   # llena pero no envía
# Tracing / Studio (cuenta personal de LangSmith)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=form-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=browser-agnet
LANGSMITH_AGENT_ENVIRONMENT=local

# --- Agente de fletes (correo entrante -> cotización) ---
# Dirección de recepción de Resend (solo informativa) y secreto del webhook email.received (whsec_...)
INBOUND_ADDRESS=
RESEND_WEBHOOK_SECRET=
# Solo estos remitentes pueden disparar el agente (JSON). Vacío = nadie.
ALLOWED_SENDERS=[]
# Hapag-Lloyd (api-portal.hlag.com): sin los tres se usa la BD simulada (MOCK_DB_PATH, por defecto artifacts/mock_freight.sqlite)
HAPAG_BASE_URL=
HAPAG_CLIENT_ID=
HAPAG_CLIENT_SECRET=

# Informe mensual (opcional; valores por defecto)
# HISTORY_DB_PATH=artifacts/mock_history.sqlite
# REPORT_DIR=artifacts/reports
